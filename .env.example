# Get these from the RunPod website
RUNPOD_API_KEY=
RUNPOD_NETWORK_VOLUME_ID=
RUNPOD_S3_ACCESS_KEY_ID=
RUNPOD_S3_SECRET_KEY=

# Git configuration (optional)
GIT_NAME=
GIT_EMAIL=

# Default values for `rpc create` (optional; CLI flags always take precedence)
#RPC_DEFAULT_GPU_TYPE=RTX A4000
#RPC_DEFAULT_RUNTIME=60
#RPC_DEFAULT_NUM_GPUS=1
#RPC_DEFAULT_CPUS=2
#RPC_DEFAULT_MEMORY=16
#RPC_DEFAULT_DISK=20
#RPC_DEFAULT_IMAGE_NAME=runpod/pytorch:1.0.2-cu1281-torch280-ubuntu2404
#RPC_DEFAULT_FORWARD_AGENT=false
#RPC_DEFAULT_SSH_PUBLIC_KEY_PATH=~/.ssh/id_ed25519.pub
#RPC_DEFAULT_BASHRC_LINE=export EDITOR=vim
